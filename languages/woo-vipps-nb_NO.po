msgstr "Hvor beskrivelsen som brukes til betalingsavtalen skal komme fra. Vist i %s-appen."

#: recurring/includes/pages/admin/vipps-recurring-admin-menu-page.php
#, php-format
msgid "If you have a lot of %s subscription orders that are currently on-hold you might want to force check the status of all the orders instead of waiting for the cron-job to do it's job."
msgstr "Om du har mange faste betalinger med %s som foreløpig er på vent kan det hende du vil til å kontrollere status på alle ordrene i stedet for å vente på at kjøring av en planlagt oppgave skal gjøre seg ferdig."

#: recurring/includes/pages/admin/vipps-recurring-admin-menu-page.php
#, php-format
msgid "Check status of all %s subscription orders now"
msgstr "Kontroller status på alle %s faste betalinger-ordre nå"

#: recurring/includes/admin/vipps-recurring-settings.php
#: recurring/includes/pages/admin/vipps-recurring-admin-menu-page.php
#: recurring/includes/wc-gateway-vipps-recurring.php
#: recurring/includes/wc-vipps-recurring.php
#, php-format
msgid "%s Recurring Payments"
msgstr "%s faste betalinger"

#: recurring/includes/wc-gateway-vipps-recurring.php
#, php-format
msgid "%1$s Recurring Payments works by redirecting your customers to %1$s for confirmation. It creates a payment plan and charges your users on the intervals you specify."
msgstr "%1$s faste betalinger virker ved å omdirigere kundene dine til %1$s for bekreftelse. Den oppretter en betalingsplan og belaster brukerne dine på de intervallene du angir."

#: recurring/includes/wc-vipps-recurring-api.php
#, php-format
msgid "Your %s Recurring Payments gateway is not correctly configured."
msgstr "Din %s faste betalinger-løsning er ikke konfigurert riktig."

#: recurring/includes/admin/vipps-recurring-settings.php
#, php-format
msgid "Enable %s Recurring Payments"
msgstr "Slå på %s faste betalinger"

#: recurring/includes/wc-vipps-recurring.php
#, php-format
msgid "%s Recurring Payments is currently in test mode - no real transactions will occur. Disable test mode when you are ready to go live!"
msgstr "%s faste betalinger er foreløpig i testmodus - ingen ekte betalinger vil finne sted. Slå av testmodus når du er klar til å gå live!"

#: recurring/includes/wc-vipps-recurring-profile.php
#, php-format
msgid "%s profile completion needs attention. Check the API configuration, assign a customer and complete the billing details, then use the order action to retry recurring completion with saved billing details. Do not create another payment."
msgstr "Fullføring av %s-profilen krever oppfølging. Kontroller API-konfigurasjonen, tilordne en kunde og fyll ut fakturaopplysningene, og bruk deretter ordrehandlingen for å prøve å fullføre den faste betalingen på nytt med de lagrede fakturaopplysningene. Ikke opprett en ny betaling."

#: recurring/includes/wc-vipps-recurring-profile.php
#, php-format
msgid "Waiting for %s profile/customer completion. Automatic status checks will retry the existing purchase."
msgstr "Venter på fullføring av %s-profil/kunde. Automatiske statuskontroller prøver det eksisterende kjøpet på nytt."
