msgstr "La kunder starte et abonnement fra en produktside, handlekurven eller kassen med opplysningene sine fra %s."

#: recurring/includes/admin/vipps-recurring-settings.php
#, php-format
msgid "Use fixed-price or free shipping. Customers cannot choose shipping in the %s app."
msgstr "Bruk fastpris eller gratis frakt. Kunden kan ikke velge frakt i %s-appen."

#: recurring/includes/admin/vipps-recurring-settings.php
#, php-format
msgid "For selected products, enable Express checkout in the product's %s tab."
msgstr "For utvalgte produkter aktiverer du hurtigkasse i produktets fane %s."

#: recurring/includes/admin/vipps-recurring-settings.php
#, php-format
