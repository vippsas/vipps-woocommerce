msgstr "Disse innstillingene er for tilkoblingen mellom butikken din og %s."

#: recurring/includes/admin/vipps-recurring-settings.php
#, php-format
msgid "Find your Merchant Serial Number in the %s developer portal."
msgstr "Finn ditt Merchant Serial Number i utviklerportalen til %s."

