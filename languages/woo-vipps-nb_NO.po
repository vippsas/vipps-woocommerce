msgstr "Hent API-nøklene dine fra utviklerportalen hos %s."

#: recurring/includes/admin/vipps-recurring-settings.php
#, php-format
msgid "Set renewal orders to \"Completed\" when %s confirms payment."
msgstr "Sett fornyelsesbestillinger til «Fullført» når %s bekrefter betalingen."

#: recurring/includes/admin/vipps-recurring-settings.php
#, php-format
msgid "Use the %s test environment to try payments."
msgstr "Bruk testmiljøet til %s for å prøve betalinger."

#: recurring/includes/wc-vipps-recurring.php
#, php-format
