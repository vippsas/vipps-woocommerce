msgid "Show the Express checkout button in the cart and supported mini-carts"
msgstr "Vis hurtigkasseknappen i handlekurven og støttede minihandlekurver"

#: recurring/includes/admin/vipps-recurring-settings.php
msgid "Checkout page"
msgstr "Kasseside"

#: recurring/includes/admin/vipps-recurring-settings.php
msgid "Show the Express checkout button on the checkout page"
msgstr "Vis hurtigkasseknappen på kassesiden"

#: recurring/includes/admin/vipps-recurring-settings.php
msgid "Subscription product buttons"
msgstr "Knapper for abonnementsprodukter"

#: recurring/includes/admin/vipps-recurring-settings.php
msgid ""
"For selected products, enable the button in the product's Vipps/MobilePay "
"Recurring Payments tab."
msgstr ""
"For utvalgte produkter aktiverer du knappen i produktfanen Vipps/MobilePay "
"Recurring Payments."

#: recurring/includes/admin/vipps-recurring-settings.php
msgid "Do not show"
